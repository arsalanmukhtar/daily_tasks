# Copy to .env (chmod 600) and fill in - see PROJECT.md's manual VM steps.
PORT=8090
APP_URL=http://localhost:8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=daily_tasks
DB_USER=daily_tasks_app
DB_PASSWORD=

# Any long random string - `openssl rand -hex 32`
JWT_SECRET=

# Same Gmail account push-daemon already used for decision/report emails -
# reuse the values from /home/gtechapp/push-daemon/.env rather than
# generating a new App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where uploaded leave attachments are saved - nginx should serve
# `/files/*` directly from this same directory in production.
UPLOAD_DIR=/home/gtechapp/daily_tasks/uploads
