# Local tooling / IDE
.claude/
.vscode/
.idea/

# OS detritus
.DS_Store
Thumbs.db

# Logs
*.log

# Local-only theme picker helper (not part of the app)
theme-preview.html

# Secrets and build artifacts - never commit these
*firebase-adminsdk*.json
*.jks
*.keystore
keystore_password*.txt
*.apk
*.aab
Leave Approvals*.zip

# Local Android signing workspace (keystore, signing tool, build output) -
# not project source, stays local only
/android_signing/

# Firebase config - contains real API keys, never committed
google-services.json

# One-time/local admin scripts (Firestore seeding, Sheets import) - the
# service-account key they need is never committed, and node_modules isn't
# either. The scripts themselves ARE committed (tools/*.js).
tools/node_modules/
tools/*.json
!tools/package.json
